# Optional. Protects /api/refresh so only Vercel Cron can run a sweep.
# Vercel Cron sends this automatically as: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Optional. Vercel KV or Upstash Redis REST credentials. Without these the
# swept prices live only in the memory of a warm serverless instance and are
# lost when it is recycled.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. Set to 1 to allow a page request to trigger a sweep when the stored
# snapshot holds no live prices or is more than twelve hours old. Useful on a
# deployment without KV; adds latency to the first request after a cold start.
SCAN_ON_REQUEST=
